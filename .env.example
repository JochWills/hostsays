# Copy to .env.local and fill in. Never commit .env.local.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep search engines out until launch (demo listings). Set to true when going live.
ALLOW_INDEXING=false
# Coming-soon gate (lib/preview.ts) is on unless this is false. Set false locally to skip it in development.
COMING_SOON=false

# Supabase (local values are printed by `npx supabase start` / `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (use test keys in development)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM="HostSays <bookings@hostsays.com>"
EMAIL_REPLY_TO=
ADMIN_EMAIL=

# Supabase Cron: requests to /api/cron/* must send "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
