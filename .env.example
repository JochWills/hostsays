# Copy to .env.local and fill in. Never commit .env.local.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local values are printed by `npx supabase start` / `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (use test keys in development)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM="HostSays <bookings@hostsays.com>"
EMAIL_REPLY_TO=
ADMIN_EMAIL=

# Render Cron Job: requests to /api/cron/* must send "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
